# -----------------------------------------------------------------------------
# FLASH SOLAR PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------

# Application URLs
NEXT_PUBLIC_APP_URL="https://flashsolar.org"
NODE_ENV="development"

# Relational Database Connection (PostgreSQL)
# When configured, Prisma connects directly to PostgreSQL.
# In local development without PostgreSQL, the system seamlessly uses the hybrid
# file-backed database store at `src/data/db-store.json`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flashsolar_db?schema=public"

# Session Security & Administrative Tokens
# Must be at least 32 characters in production. Used for HMAC-SHA256 session signatures.
NEXTAUTH_SECRET="flashsolar_dev_secure_session_secret_key_2026_change_in_production"

# Transactional Email Dispatcher (Resend)
# Optional in local development: the system defaults to structured console simulation.
# When provided, emails are dispatched via the Resend HTTP API.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Flash Solar <notifications@flashsolar.org>"
COMPANY_NOTIFICATION_EMAIL="info@flashsolar.org"

# Initial Administrative Seed Account
# Used by seeding scripts and initial setup
ADMIN_INITIAL_EMAIL="admin@flashsolar.org"
ADMIN_INITIAL_PASSWORD="FlashSolar2026!"
